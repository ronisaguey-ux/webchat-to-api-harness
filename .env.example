# API Keys for Oculus
# These must be set in the environment before running.

DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
OCULUS_REGIME_HMAC_KEY=your_hmac_key_here

# ── MODE / FEATURE TOGGLES (09-04) ─────────────────────────────────────────
# Dialect endpoints
#RESPONSES_BRIDGE=1              # enable /v1/responses (pi/shannon agents)
#CHAT_COMPLETIONS_SSE=1          # SSE stream branch on /v1/chat/completions
# Tool-protocol emulation
#CALL_FIRST=1                    # call-first formatText: reply MUST start with CALL_TOOL
#TOOL_SCHEMA_SLICE=0             # 0 = inject ALL tool schemas; N = first N (default 0)
#JSON_TEXT_FALLBACK=1            # upgrade queue-shaped JSON in prose to a function_call
#THINKING_HEAD_GUARD=0           # set 0 to take short "Analyzing..." thinking headlines
# Retry / pacing
#MAX_TOOL_ROUNDS=40              # per-request tool-round budget
#FORMAT_ERROR_ROUNDS=4           # consecutive plain-text replies before bailing
#MIN_LANE_GAP_SECONDS=0          # >0 = interleave delay before each send (rate-limit relief)
# Persistence / presentation
#SAVE_COOKIES=0                  # set 0 to stop persisting cookies
#COLLAPSE_REPLIES=0              # set 0 to keep big tool-JSON replies visible in the tab
#INSTANT_SWAP_EXPERT=0           # deepseek thread-swap pins (expert mode swap per send)
#FORCE_EXPERT=0
# Browser identity
#USER_AGENT_OVERRIDE=            # e.g. a fixed UA string; empty = browser default
#FINGERPRINT_PLATFORM=windows    # cloak antidetect platform (windows|linux|macos|android)
