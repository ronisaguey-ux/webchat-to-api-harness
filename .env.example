# ── Server ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080

# ── Webchat target ──────────────────────────────────────
# ⭐ EASIEST: paste your tab URL into chat.js — that file wins
# over this env var and is the only place you need to touch.
WEBCHAT_URL=https://chat.deepseek.com
# false = visible browser so you can log in manually
HEADLESS=false
# Optional: attach to your ALREADY-OPEN browser (see chat.js)
# CDP_WS_URL=ws://127.0.0.1:9223/devtools/browser/…

# ── Security (READ README.md before enabling) ──────────
# Requires Authorization: Bearer <token> on every request
# API_TOKEN=change-me
# run_bash tool is DISABLED unless this is true — enabling it lets
# the webchat model execute arbitrary shell commands on this machine
# BASH_ALLOWED=true

# ── Upstream proxy (dual-model gateway) ─────────────────
# Requests with model != anymodel (e.g. deepseek-v4-flash) are proxied
# verbatim to this upstream, so one base URL serves BOTH the webchat tab
# and a real API. Set the token in your .env — no default.
# UPSTREAM_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# UPSTREAM_OPENAI_BASE_URL=https://api.deepseek.com/v1
# UPSTREAM_ANTHROPIC_AUTH_TOKEN=sk-your-paid-key

# ── Behaviour ──────────────────────────────────────────
TIMEOUT=60000
TOOL_CONTEXT_WINDOW=8000
MAX_TOOL_ROUNDS=4
LOGIN_WAIT_SECONDS=300
EXEC_TIMEOUT_MS=10000
# SKIP_BROWSER=true starts the server without launching a browser
# (useful for testing the API surface)
SKIP_BROWSER=false

# ── Selector overrides (when the webchat UI changes) ───
# SELECTOR_INPUT=textarea, div[contenteditable="true"]
# SELECTOR_SEND=button[type="submit"], .send-button
# SELECTOR_MESSAGE=.message, .chat-message, .response

# ── Context handoff (auto-swap to a new chat) ──────────
# When the rough per-request context fed to the webchat model (chars/4 ≈
# tokens, tool sections counted on every round) crosses the threshold, the
# gateway stops the tool loop, has the model write a handoff document,
# opens a NEW chat in the same tab, and seeds it with the document as the
# first message. Thread pins (chat.js + the supervisor's WEBCHAT_URL line)
# are swapped automatically so respawns follow the new chat.
# CONTEXT_HANDOFF_ENABLED=true
# CONTEXT_HANDOFF_THRESHOLD=100000   # ≈78% of DeepSeek's 128K window
# HANDOFF_FILE=/home/roni/Roni_workspace/handoff_to_new_chat.md
