#!/usr/bin/env bash
# Secret guard (2026-10-05). Refuses a commit that stages a credential file.
#
# WHY THIS EXISTS, next to .gitignore: .gitignore is a TRACKED file, so a plan step,
# a sweep, or a careless rewrite can delete its rules and silently un-protect every
# secret in the tree. That already happened once in this workspace - a step rewrote
# .gitignore down to a single rule and left the API keys untracked-but-not-ignored.
# A hook is not part of the repo, so nothing that edits the repo can disable it, and
# `git add -f` - the one thing .gitignore cannot stop - is caught here too.
#
# Recover with: git reset HEAD <path>   (the file itself is untouched)
set -uo pipefail

pat='(^|/)\.env$|(^|/)\.env\.[^/]+$|\.env\.(bak|disabled|local|production|staging|dev|old|save)$|(^|/)\.envrc$|\.token$|\.pem$|\.key$|\.p12$|\.pfx$|(^|/)id_(rsa|dsa|ecdsa|ed25519)(\.|$)|(^|/)credentials(\.|$)|(^|/)\.netrc$|(^|/)\.npmrc$|(^|/)\.pypirc$|(^|/)\.cookies[^/]*\.json$|(^|/)cookies\.json$|_key\.txt$|(^|/)\.git-credentials$'

allow='(^|/)\.env\.(example|sample|template|dist)$|\.example$|\.sample$|\.template$|(^|/)tests?/|(^|/)test_|_test\.|(^|/)conftest\.py$|(^|/)fixtures?/|(^|/)docs?/'

hits=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$pat" | grep -vE "$allow" || true)
if [ -n "$hits" ]; then
  echo "" >&2
  echo "✗ SECRET GUARD: refusing to commit credential files:" >&2
  echo "$hits" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  These are ignored by design. If this is a genuine false positive" >&2
  echo "  (a template or a test fixture), stage it with:" >&2
  echo "      git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# a huge binary is almost always a data file, not source
big=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
        [ -f "$f" ] || continue
        sz=$(wc -c < "$f" 2>/dev/null || echo 0)
        [ "$sz" -gt 5242880 ] && echo "$f ($((sz/1048576))MB)"
      done)
if [ -n "$big" ]; then
  echo "✗ SECRET GUARD: staged file(s) over 5MB - commit data separately:" >&2
  echo "$big" | sed 's/^/    /' >&2
  exit 1
fi
exit 0
