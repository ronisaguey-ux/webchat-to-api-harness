{
  "_README": [
    "MASTER CONFIG \u2014 one place to turn every harness feature on or off and to",
    "pick the webchat it is talking to.",
    "",
    "Precedence, highest first:",
    "  1. environment variable   (e.g. ANTI_SPIRAL=true node server.js)",
    "  2. a systemd drop-in      (Environment=ANTI_SPIRAL=true)",
    "  3. this file              (the value below)",
    "  4. the built-in default   (shown in README.md)",
    "",
    "So anything you set here is a baseline a per-instance env var can still",
    "override. Values you leave out fall back to the built-in default. Every key",
    "is optional.",
    "",
    "WEBCHAT MODES: every webchat needs slightly different selectors and submit",
    "behaviour. Set \"webchat.mode\" to one of the keys under \"webchatModes\"",
    "below (generic, deepseek, chatgpt, gemini, kimi). The mode fills in the",
    "selectors and quirks; anything you set explicitly still wins.",
    "",
    "If your webchat does not work with \"generic\", open an issue and it will get",
    "a dedicated mode.",
    "",
    "Features marked EXPERIMENTAL are off by default and have not been proven in",
    "daily use \u2014 read the README section before enabling one.",
    "",
    "limits.maxToolRounds = the hard cap on tool-execution rounds per request.",
    "limits.wrapUpRounds  = how many rounds before that cap the harness stops the model and demands its final answer (default 3).",
    "",
    "notegpt is TESTED but its composer holds a stale draft and resists both clear mechanisms; the lane is parked. The mode exists so a fix can be dropped in without touching code."
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "headless": false,
    "modelName": "deepseek webchat"
  },
  "webchat": {
    "mode": "generic",
    "url": "",
    "urlOverride": false,
    "tabUrlSubstring": "",
    "cdpWsUrl": "",
    "viewportW": 0,
    "viewportH": 0,
    "loginWaitSeconds": 300,
    "selectors": {
      "input": "",
      "send": "",
      "message": ""
    }
  },
  "systemPrompt": {
    "_comment": "Sent as the system message on every request. Leave \"text\" empty to use the harness's built-in prompt. Set \"mode\" to override it per webchat (generic/deepseek/chatgpt/gemini/kimi); a per-mode prompt, when present, wins over \"text\".",
    "mode": "",
    "text": "",
    "perMode": {
      "generic": "",
      "deepseek": "",
      "chatgpt": "",
      "gemini": "",
      "kimi": "",
      "notegpt": ""
    }
  },
  "webchatModes": {
    "generic": {
      "_comment": "No assumptions. Use this if your webchat is not listed \u2014 if it does not work, open an issue and it gets its own mode.",
      "url": "",
      "tabUrlSubstring": "",
      "selectors": {
        "input": "",
        "send": "",
        "message": ""
      }
    },
    "deepseek": {
      "url": "https://chat.deepseek.com",
      "tabUrlSubstring": "",
      "selectors": {
        "input": "textarea",
        "send": "div[role=\"button\"].ds-button--primary, div[role=\"button\"].ds-button--filled, button[aria-label*=\"Send\" i]",
        "message": ".ds-markdown, .message"
      },
      "quirks": {
        "clearComposerWithKeyEvents": false,
        "enterSubmits": false,
        "clickFallbackOnFullComposer": true,
        "autoContinueButton": true,
        "skipEmptyMessageRows": false,
        "ignoreStopButtonWhileBusy": false
      }
    },
    "chatgpt": {
      "url": "https://chatgpt.com",
      "tabUrlSubstring": "chatgpt.com",
      "selectors": {
        "input": "#prompt-textarea",
        "send": "button[data-testid=\"send-button\"], button[aria-label*=\"Send\" i]",
        "message": "[data-message-author-role=\"assistant\"]"
      },
      "quirks": {
        "clearComposerWithKeyEvents": false,
        "enterSubmits": false,
        "clickFallbackOnFullComposer": true,
        "autoContinueButton": true,
        "skipEmptyMessageRows": true,
        "ignoreStopButtonWhileBusy": true
      }
    },
    "gemini": {
      "url": "https://gemini.google.com",
      "tabUrlSubstring": "gemini.google.com",
      "selectors": {
        "input": "div[contenteditable=\"true\"], rich-textarea .ql-editor",
        "send": "button[aria-label*=\"Send\" i], button.send-button",
        "message": "model-response, .model-response-text"
      },
      "quirks": {
        "clearComposerWithKeyEvents": false,
        "enterSubmits": true,
        "clickFallbackOnFullComposer": false,
        "autoContinueButton": false,
        "skipEmptyMessageRows": false,
        "ignoreStopButtonWhileBusy": false,
        "phantomStopButton": true
      }
    },
    "kimi": {
      "url": "https://www.kimi.ai/chat",
      "tabUrlSubstring": "kimi.ai/chat",
      "selectors": {
        "input": ".chat-input-editor",
        "send": "button[aria-label*=\"Send\" i], .send-button",
        "message": ".chat-content-item-assistant"
      },
      "quirks": {
        "clearComposerWithKeyEvents": true,
        "enterSubmits": true,
        "clickFallbackOnFullComposer": true,
        "autoContinueButton": true,
        "skipEmptyMessageRows": false,
        "ignoreStopButtonWhileBusy": false,
        "restoresSavedDraft": true
      }
    },
    "notegpt": {
      "url": "https://notegpt.io/ai-chat",
      "tabUrlSubstring": "notegpt.io",
      "selectors": {
        "input": "div[contenteditable=\"true\"]",
        "send": "button.bg-primary, button[aria-label*=\"Send\" i]",
        "message": ".markdown-body, .prose, .message"
      },
      "quirks": {
        "clearComposerWithKeyEvents": false,
        "enterSubmits": false,
        "clickFallbackOnFullComposer": true,
        "autoContinueButton": false,
        "skipEmptyMessageRows": false,
        "ignoreStopButtonWhileBusy": false,
        "sendInPageOnly": true,
        "composerHoldsStaleDraft": true
      }
    }
  },
  "features": {
    "narration": false,
    "antiSpiral": false,
    "driftDetect": 2,
    "contextHandoff": true,
    "allowPlainText": false,
    "bashAllowed": false,
    "sandbox": true,
    "sandboxAllowBash": false,
    "blockedCss": false
  },
  "limits": {
    "timeoutMs": 1800000,
    "maxToolRounds": 40,
    "toolContextWindow": 30000,
    "contextHandoffThreshold": 2000000,
    "antiSpiralMinWords": 40,
    "execTimeoutMs": 10000,
    "wrapUpRounds": 3
  },
  "paths": {
    "workspaceRoot": "",
    "auditsPlansDir": "",
    "driftReportDir": "",
    "mainInboxFile": "",
    "handoffFile": "",
    "cookieFile": ".cookies.json"
  },
  "network": {
    "blockedUrlsExtra": [],
    "sandboxRoots": []
  }
}